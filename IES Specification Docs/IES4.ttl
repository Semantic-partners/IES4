###  http://ies.data.gov.uk/ontology/ies4#SecurityLabel
ies:SecurityLabel rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty ies:payloadLabel ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass ies:ExchangePayload
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ies:permittedNationality ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ies:permittedOrganisation ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ies:protectiveMarking ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ies:orGroup ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  sparx:guid "{CED628E4-8641-486b-BCD7-CB4E147E7AE6}" ;
                  rdfs:comment "A SecurityLabel may be assigned at the statement (triple) level or to the entire ExchangePayload. They provide a mechanism to specify access restrictions and handling instructions for specific triples.Note: In any given IES exchange, a SecurityLabel must be applied to the ExchangePayload. Individual SecurityLabels at the statement level are used to indicate where individual statements deviate from the overall payload SecurityLabel" .


