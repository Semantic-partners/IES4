                              ] ;
                  rdfs:range ies:ParticularPeriod ;
                  sparx:guid "{6ACC2ACC-46F2-4a02-A3E7-D16BE8EB723B}" ;
                  rdfs:comment "The date that the respective IdentityDocument or Ticket is valid from." .


