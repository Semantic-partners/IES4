@prefix ies: <http://ies.data.gov.uk/ontology/ies4#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sparx: <http://data.sparxsystems.com#> .
@base <http://ies.data.gov.uk/ontology/ies4#> .

<http://ies.data.gov.uk/ontology/ies4> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://data.sparxsystems.com#guid
sparx:guid rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://ies.data.gov.uk/ontology/ies4#aCopyOf
ies:aCopyOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf rdf:type ;
            rdfs:domain ies:IndividualDocument ;
            rdfs:range ies:WorkOfDocumentation ;
            sparx:guid "{22D9054C-AE5C-4afe-99D9-3C9D65C86CB9}" ;
            rdfs:comment "An rdf:type relationship that asserts a Document is a copy of WorkOfDocumentationNote: Document instances are individual physical documents whereas WorkOfDocumentation is the general case of a document - e.g. War and Peace vs my copy of War and Peace" .


###  http://ies.data.gov.uk/ontology/ies4#accountForCard
ies:accountForCard rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ies:relationship ;
                   rdfs:domain ies:BankCard ;
                   rdfs:range ies:FinancialAccount ;
                   sparx:guid "{7891E893-56DB-4d47-80B4-C78A667767F6}" ;
                   rdfs:comment "Relates a BankCard to the FinancialAccount which the card is issued against." .


###  http://ies.data.gov.uk/ontology/ies4#accountProvider
ies:accountProvider rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf ies:relationship ;
                    rdfs:domain ies:Account ;
                    rdfs:range ies:Organisation ;
                    sparx:guid "{0F9244C3-B2F5-4b8a-AED2-54B7FDAB9578}" ;
                    rdfs:comment "The Organisation that provides the FinancialAccount" .


###  http://ies.data.gov.uk/ontology/ies4#addressRegion
ies:addressRegion rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ies:inLocation ;
                  rdfs:domain ies:Address ;
                  rdfs:range ies:RegionOfCountry ;
                  sparx:guid "{3E452516-2523-4a86-974D-1D2251057E6E}" ;
                  rdfs:comment "An inLocation relationship to indicate an Address is in a RegionOfCountry" .


###  http://ies.data.gov.uk/ontology/ies4#after
ies:after rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf ies:relationship ;
          rdfs:domain ies:Element ;
          rdfs:range ies:Element ;
          sparx:guid "{FA4DDF04-16DA-4b5c-AE9A-6AB8CD07DCDB}" ;
          rdfs:comment "A relationship linking two Elements where one ends before the other starts" .


###  http://ies.data.gov.uk/ontology/ies4#allAuthorisedAgainst
ies:allAuthorisedAgainst rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf ies:relationship ;
                         rdfs:domain ies:AuthorisedEventClass ;
                         rdfs:range ies:ExchangedItem ;
                         sparx:guid "{97E2E16A-5D4C-41bd-AF32-8DF2057A35BA}" ;
                         rdfs:comment "A relationship linking an AuthorisedEventClass to an ExchangedItem to assert that all instances of the AuthorisedEventClass were Events acting upon the ExchangedItem.Note: this is generally a law-enforcement concern where a warrant (EndToEndAuthorisation) is granted against people, devices, etc. (GrantOfAuthority)." .


###  http://ies.data.gov.uk/ontology/ies4#allHaveCharacteristic
ies:allHaveCharacteristic rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ies:relationship ,
                                             rdfs:subClassOf ;
                          rdfs:domain ies:ClassOfElement ;
                          rdfs:range ies:Characteristic ;
                          sparx:guid "{81A1E70D-6ADB-4843-BCA6-C0A710E7716B}" ;
                          rdfs:comment "An rdfs:subClassOf relationship that asserts that all instances of a ClassOfElement share a particular Characteristic or Measuree.g. all London buses being red, all heavyweight boxers weighing more than 200lbs" .


###  http://ies.data.gov.uk/ontology/ies4#allHaveDisposition
ies:allHaveDisposition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ies:relationship ,
                                          rdfs:subClassOf ;
                       rdfs:domain ies:Element ;
                       rdfs:range ies:DispositionalClass ;
                       sparx:guid "{6F8504E0-E03C-43fa-AA81-C3341CA551E3}" ;
                       rdfs:comment "An rdfs:subClassOf relationship that asserts that all instances of a ClassOfElement share a dispositione.g. all Eurofighters being cable of Mach 2" .


###  http://ies.data.gov.uk/ontology/ies4#alliedTo
ies:alliedTo rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ies:relationship ;
             rdfs:domain ies:ResponsibleActorState ;
             rdfs:range ies:Alliance ;
             sparx:guid "{7F818F57-2C3B-4629-8EEC-F5F8310AE655}" ;
             rdfs:comment "A Relationship between two ResponsibleActor Entities where one is allied to the other." .


###  http://ies.data.gov.uk/ontology/ies4#ancestorOf
ies:ancestorOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ies:familiallyRelatedTo ;
               rdfs:domain ies:Person ;
               rdfs:range ies:Person ;
               sparx:guid "{15388C46-262D-4f70-8F65-83758A5AEAF5}" ;
               rdfs:comment "A Relationship between two Person Entities that indicates one is and ancestor of the otherNote: was called relative of in IES 3.x, but was really only about ancestry, so is changed here. " .


###  http://ies.data.gov.uk/ontology/ies4#areaOfCoverage
ies:areaOfCoverage rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ies:relationship ;
                   rdfs:domain ies:TravelCard ;
                   rdfs:range ies:Location ;
                   sparx:guid "{C6BA7464-C00E-4ff6-AE7B-9CE9D4E08FDF}" ;
                   rdfs:comment "The area over which the TravelCard is valid Examples:London ñ Zone 1London ñ All Zones" .


###  http://ies.data.gov.uk/ontology/ies4#assessed
ies:assessed rdf:type owl:ObjectProperty ;
             rdfs:domain ies:AssessToBeTrue ;
             rdfs:range rdfs:Resource ;
             sparx:guid "{669E3CD0-CD9D-496c-A711-ECDE3F589012}" ;
             rdfs:comment "An owl:objectProperty that links an AssesToBeTrue to the rdfs:Resource that is assessed to be true." .


###  http://ies.data.gov.uk/ontology/ies4#assessedToBeTheSameAs
ies:assessedToBeTheSameAs rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf ies:relationship ;
                          sparx:guid "{6A1C6C65-D671-4ea3-9184-044AE2A802CF}" ;
                          rdfs:comment "A relationship that asserts two ExchangedItems that may have been previously judged to be different are in fact the same thing. WARNING:  by the same we mean they occupy the same space for the same period of time - i.e. not two different things in the same place at different times, and not the same physical item at two different periods of time. The Identifier and State patterns should do most of what is needed here, and it is extremely rare that this would ever be needed. Do not use unless absolutely necessary. " .


###  http://ies.data.gov.uk/ontology/ies4#associatedCarrier
ies:associatedCarrier rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ies:relationship ;
                      rdfs:domain ies:TravelTicket ;
                      rdfs:range ies:Organisation ;
                      sparx:guid "{2E464C7F-FC0B-4dcc-9B1C-5DCA87B4CE3A}" ;
                      rdfs:comment "The Organisation that provides the transport specified on the Ticket" .


###  http://ies.data.gov.uk/ontology/ies4#authorisesAccessTo
ies:authorisesAccessTo rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ies:relationship ;
                       rdfs:domain ies:Ticket ;
                       rdfs:range ies:Event ;
                       sparx:guid "{A2DA918D-843C-43c9-A974-4795601E9D65}" ;
                       rdfs:comment "The Event for which the respective Ticket applies." .


###  http://ies.data.gov.uk/ontology/ies4#beginBoundOfClass
