###  http://ies.data.gov.uk/ontology/ies4#ExchangePayload
ies:ExchangePayload rdf:type owl:Class ;
                    sparx:guid "{749B002E-37B1-4754-B3B2-96642B3CF4A7}" ;
                    rdfs:comment "A marker object that shall be present in all IES exchange files. This object is the domain for all meta-data about the file.Wherever possible, Dublin-Core meta-data tags should be used on an ExchangePayload. If locally defined properties are needed, then these may also be defined and included in the exchange file. " .


