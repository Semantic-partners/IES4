              rdfs:subPropertyOf ies:attribute ;
              rdfs:domain ies:WebResourceState ;
              sparx:guid "{D97141BD-F6CF-4b10-B4E5-B1ECF6DF5178}" ;
              rdfs:comment "URI scheme is the top level of the uniform resource identifier (URI) naming structure. All URIs and absolute URI references are formed with a scheme name, followed by a colon character (:), and the remainder of the URI called the scheme-specific part." .


