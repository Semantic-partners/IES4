                          rdfs:domain ies:Account ,
                                      ies:Organisation ,
                                      ies:Vehicle ;
                          rdfs:range ies:Country ;
                          sparx:guid "{D33498ED-B6A0-41ea-864F-CE95E2B1E010}" ;
